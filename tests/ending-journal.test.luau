local Journal = require("../src/server/EndingJournal")

local empty = Journal.merge(nil, nil)
assert(not empty.broadcast and not empty.shelter)
local broadcast = Journal.merge(nil, {broadcast = true})
local both = Journal.merge({shelter = true}, broadcast)
assert(both.broadcast and both.shelter, "an update must preserve the other ending")
local lateLoad = Journal.merge(both, broadcast)
assert(lateLoad.broadcast and lateLoad.shelter, "an older read cannot erase a new ending")
assert(not Journal.merge({broadcast = "yes", shelter = 1}, false).broadcast)
assert(not Journal.merge({broadcast = "yes", shelter = 1}, false).shelter)
assert(not broadcast.shelter, "merging does not mutate earlier snapshots")
local archives = Journal.merge({broadcast = true, west = true}, {shelter = true, east = true})
assert(archives.west and archives.east and archives.broadcast and archives.shelter)
assert(not Journal.merge({west = "yes", east = 1}).west and not Journal.merge({east = 1}).east)
assert(empty.bestClearSeconds == nil)
assert(empty.finishPreference == nil)
local newerFinish = {finish = "Standard", changedAt = 200}
local olderFinish = {finish = "Aurora", changedAt = 100}
local savedFinish = Journal.merge({finishPreference = newerFinish}, {finishPreference = olderFinish, shelter = true})
assert(savedFinish.finishPreference.finish == "Standard" and savedFinish.shelter, "an older save cannot replace the chosen finish")
assert(savedFinish.finishPreference ~= newerFinish, "merging must copy the preference")
assert(Journal.merge({finishPreference = olderFinish}, {finishPreference = newerFinish}).finishPreference.finish == "Standard")
assert(Journal.merge({finishPreference = {finish = "Invalid", changedAt = 500}}).finishPreference == nil)
assert(Journal.merge({bestClearSeconds = 82}, {bestClearSeconds = 64}).bestClearSeconds == 64)
assert(Journal.merge({bestClearSeconds = 64}, {bestClearSeconds = 82}).bestClearSeconds == 64)
for _, bad in {0, -1, 1.5, 0/0, math.huge, "12"} do
	assert(Journal.merge({bestClearSeconds = bad}, {bestClearSeconds = 64}).bestClearSeconds == 64)
end
local player = {UserId = 5, SetAttribute = function(self, key, value) self[key] = value end}
local journal = Journal.new(nil)
journal:join(player)
assert(journal:setFinish(player, "Aurora", 101))
assert(journal:setFinish(player, "Signal", 101))
assert(player.PreferredCellFinish == "Signal")
assert(not journal:setFinish(player, "Invalid", 102))
journal:award(player, "broadcast", "west")
journal:award(player, "shelter", "east")
assert(player.EndingBroadcast and player.EndingShelter and not player.ArchiveWest and not player.ArchiveEast)
assert(journal:award(player, "broadcast", "west"))
assert(not journal:award(player, "broadcast", "west"), "duplicates cannot unlock a record twice")
assert(player.ArchiveWest and not player.ArchiveGold)
journal:award(player, "shelter", "east")
journal:leave(player)
journal:join(player)
assert(player.ArchiveWest and player.ArchiveEast and player.ArchiveGold)
local _, _, firstBest = journal:award(player, "shelter", nil, nil, 82)
assert(firstBest and player.BestClearSeconds == 82)
local _, _, slower = journal:award(player, "shelter", nil, nil, 90)
assert(not slower and player.BestClearSeconds == 82)
local _, _, tied = journal:award(player, "shelter", nil, nil, 82)
assert(not tied and player.BestClearSeconds == 82)
local _, _, faster = journal:award(player, "shelter", nil, nil, 64)
assert(faster and player.BestClearSeconds == 64)
print("PASS: journal defaults, atomic union, stale read, malformed data, immutable snapshots")
