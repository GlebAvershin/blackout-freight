assert(game:GetService("RunService"):IsStudio())
local test = game:GetService("StudioTestService")
task.delay(125, function() test:EndTest("TIMEOUT") end)
local Players = game:GetService("Players")
local storage = game:GetService("ReplicatedStorage")
local state = storage:WaitForChild("Freight"):WaitForChild("Shift")
local serverStorage = game:GetService("ServerStorage")
local press = serverStorage:WaitForChild("FreightTestAction")
local prepare = serverStorage:WaitForChild("FreightTestPreparation")
local world = workspace:WaitForChild("Blackout Freight • Depot 07")
local function waitFor(f, label, seconds)
	local deadline = os.clock() + (seconds or 8)
	repeat if f() then return end; task.wait(0.05) until os.clock() > deadline
	error("ROLES QA " .. label)
end
local success, failure = xpcall(function()
local probeWorld = Instance.new("Folder")
local probePlayer = Instance.new("Folder")
local root = Instance.new("Part")
root.Position = Vector3.new(0,3,0)
local shelters = require(script.Parent.LightShelters).new(probeWorld, require(script.Parent.Depot), require(storage.Freight.Roles))
shelters.deploy(probePlayer, root, 0)
assert(not shelters.protects(root.Position), "setup granted early protection")
shelters.step(2, function() return root end)
assert(shelters.protects(Vector3.new(9,3,0)) and not shelters.protects(Vector3.new(10,3,0)), "shelter radius")
assert(not shelters.protects(Vector3.new(0,10,0)), "shelter vertical bounds")
shelters.step(7, function() return root end)
assert(not shelters.protects(root.Position) and #probeWorld:GetChildren() == 0, "expiry cleanup")
shelters.deploy(probePlayer, root, 8)
shelters.step(9, function() return nil end)
assert(#probeWorld:GetChildren() == 0, "dead owner cleanup")
shelters.deploy(probePlayer, root, 10)
shelters.clear()
assert(#probeWorld:GetChildren() == 0 and probePlayer:GetAttribute("ShelterSetupUntil") == 0, "shift cleanup")
probeWorld:Destroy(); probePlayer:Destroy(); root:Destroy()
waitFor(function() return #Players:GetPlayers() == 2 end, "two clients", 70)
local a, b = table.unpack(Players:GetPlayers())
for _, player in {a,b} do
	waitFor(function() return player.Character and player.Character:FindFirstChild("HumanoidRootPart") end, "character")
	player.Character.HumanoidRootPart:SetNetworkOwner(nil)
end
waitFor(function() return state:GetAttribute("Phase") == "live" end, "live shift")
local function go(player, point)
	local root = player.Character.HumanoidRootPart
	player.Character.Humanoid:MoveTo(Vector3.new(point.X, root.Position.Y, point.Z))
	waitFor(function() return (Vector3.new(root.Position.X,0,root.Position.Z)-Vector3.new(point.X,0,point.Z)).Magnitude < 2 end, "walk")
	task.wait(0.15)
end
local function prompt(name) return world:FindFirstChild(name):FindFirstChildWhichIsA("ProximityPrompt",true) end
local function walkPrompt(player, p)
	go(player, p.Parent.WorldPosition + Vector3.new(0,0,p.ObjectText == "Power cell" and 3 or -3))
	press:Invoke(p, player)
end
local function cell()
	for _, model in world:GetChildren() do
		local p = model.Name == "Power Cell" and model:FindFirstChildWhichIsA("ProximityPrompt",true)
		if p and p.Enabled and model.PrimaryPart.Position.Z == 42 and model.PrimaryPart.Position.X == -9 then return p end
	end
	error("first battery missing")
end
local scanResult = Instance.new("RemoteEvent")
scanResult.Name = "ScanQAResult"
local scans = {}
scanResult.OnServerEvent:Connect(function(player, status) scans[player] = status end)
scanResult.Parent = storage
walkPrompt(a,cell())
walkPrompt(a,prompt("Delivery console"))
walkPrompt(a,prompt("01   BROADCAST"))
waitFor(function() return state:GetAttribute("Phase") == "won" end,"first win")
prepare:Invoke(a,"role","Technician")
prepare:Invoke(b,"role","Scout")
waitFor(function() return state:GetAttribute("Phase") == "live" end,"support shift",24)
assert(a:GetAttribute("CrewRole") == "Technician" and b:GetAttribute("CrewRole") == "Scout")
prepare:Invoke(a,"ability")
assert(a:GetAttribute("AbilityReadyAt") == 0,"shelter at safe spawn")
go(a,Vector3.new(-9,3,47))
prepare:Invoke(a,"ability")
assert(world:FindFirstChild("Crew light shelter"),"shelter setup absent")
go(a,Vector3.new(0,3,49))
waitFor(function() return not world:FindFirstChild("Crew light shelter") end,"moving cancels setup")
local readyAt = a:GetAttribute("AbilityReadyAt")
prepare:Invoke(a,"ability")
assert(a:GetAttribute("AbilityReadyAt") == readyAt and not world:FindFirstChild("Crew light shelter"),"cancel bypassed cooldown")
go(a,Vector3.new(-4,3,47))
go(b,Vector3.new(-9,3,45))
waitFor(function() return workspace:GetServerTimeNow() >= readyAt end,"technician cooldown",34)
prepare:Invoke(a,"ability")
waitFor(function() return a:GetAttribute("ShelterSetupUntil") == 0 end,"shelter arms",4)
local shelter = assert(world:FindFirstChild("Crew light shelter"))
assert(math.abs(shelter.Transparency - 0.65) < 0.01,"armed shelter not visible")
press:Invoke(cell(), b)
assert(b:GetAttribute("Carrying"),"scout failed pickup")
task.wait(0.3)
assert(not b:GetAttribute("Tracked"), "shelter did not hide teammate: " .. tostring(b.Character.HumanoidRootPart.Position) .. " vs " .. tostring(shelter.Position) .. " active=" .. tostring(shelter.Parent ~= nil))
prepare:Invoke(b,"ability", "fake")
assert(b:GetAttribute("AbilityReadyAt") == 0,"malformed scan accepted")
task.wait(0.6)
prepare:Invoke(b,"ability")
local scanReady = b:GetAttribute("AbilityReadyAt")
assert(scanReady > workspace:GetServerTimeNow(),"scan cooldown absent")
waitFor(function() return scans[b] == "visible" end,"private scan visible")
assert(scans[a] == nil,"scan leaked to teammate")
task.wait(0.6)
prepare:Invoke(b,"ability")
assert(scanReady == b:GetAttribute("AbilityReadyAt"),"scan spam renewed cooldown")
waitFor(function() return not world:FindFirstChild("Crew light shelter") end,"shelter expires",7)
waitFor(function() return b:GetAttribute("Tracked") end,"drone reacquires outside protection")
walkPrompt(b,prompt("Delivery console"))
walkPrompt(b,prompt("01   BROADCAST"))
waitFor(function() return scans[b] == "cleared" end,"scan cleanup")
assert(not world:FindFirstChild("Crew light shelter"))
print("ROLES QA PASS support: two clients, setup cancellation, cooldown, teammate shelter, expiry, reacquire, private scan, cleanup")
test:EndTest("PASS")

end, debug.traceback)
if not success then warn(failure); test:EndTest("FAIL: " .. tostring(failure)) end
