local P = require("../src/shared/Progression")
assert(P.reward(0, 1.5) == 0 and P.reward(2, 1.25) == 25 and P.reward(8, 1.5) == 75)
assert(P.chooseHeat({}, false) == 1)
assert(P.chooseHeat({3,3,1}, true) == 1)
assert(P.chooseHeat({2,3}, false) == 2)
assert(P.chooseHeat({3,3,2}, false) == 3)
assert(P.chooseHeat({0,4,0/0,"3"}, false) == 1)
local Profile = require("../src/server/Profile")
local saved
local store = {UpdateAsync = function(_, _, f) saved = f(saved); return saved end}
local profile = Profile.new(store, "cap", function() return 1000 end)
profile:acquire(1)
for i=1,8 do profile:transact(1,i,{kind="reward",amount=100}) end
assert(saved.scrap == 600 and saved.rankXP == 600)
profile:release(1)
local nextServer = Profile.new(store,"next",function() return 1100 end)
nextServer:acquire(1)
assert(nextServer:transact(1,1,{kind="reward",amount=100}).lastAward == 0)
print("PASS: rewards, persistent hourly cap, heat votes, novice protection, ties")
assert(P.chooseHeat({5,5,4}, false, true) == 5)
assert(P.chooseHeat({4,5}, false, true) == 4)
assert(P.chooseHeat({5,5,3}, false, false) == 3)
assert(P.chooseHeat({5,5}, true, true) == 1)
assert(P.reward(5, 2.2) == 110)
assert(P.walletReward(110, true, true) == 220 and P.walletReward(110, false, true) == 137)
local fresh = Profile.new(store,"new-hour",function() return 7200 end)
nextServer:release(1)
assert(fresh:acquire(1))
for i=1,4 do assert(fresh:transact(1,i,{kind="reward",amount=110,doubleScrap=true})) end
assert(saved.scrap == 1200 and saved.rankXP == 1040)
assert(fresh:transact(1,4,{kind="reward",amount=110,doubleScrap=true}).scrap == 1200)
for i,id in {"Rack", "Lamp"} do
 local item = P.Catalog[id]
 assert(fresh:transact(1,4+i,{kind="upgrade",id=id,price=item.price}).upgrades[id])
end
assert(saved.scrap == 500)
assert(fresh:transact(1,7,{kind="adReward",purchaseId="video-1"}).scrap == 525)
assert(fresh:transact(1,8,{kind="adReward",purchaseId="video-1"}).scrap == 525)
fresh:release(1)
assert(nextServer:acquire(1))
assert(nextServer:transact(1,1,{kind="adReward",purchaseId="video-1"}).scrap == 525)
