assert(game:GetService("RunService"):IsStudio())
local test = game:GetService("StudioTestService")
task.delay(125, function() test:EndTest("TIMEOUT") end)
local Players = game:GetService("Players")
local storage = game:GetService("ReplicatedStorage")
local state = storage:WaitForChild("Freight"):WaitForChild("Shift")
local serverStorage = game:GetService("ServerStorage")
local press = serverStorage:WaitForChild("FreightTestAction")
local prepare = serverStorage:WaitForChild("FreightTestPreparation")
local world = workspace:WaitForChild("Blackout Freight • Depot 07")
local function waitFor(f, label, seconds)
	local deadline = os.clock() + (seconds or 8)
	repeat if f() then return end; task.wait(0.05) until os.clock() > deadline
	error("ROLES QA " .. label)
end
waitFor(function() return #Players:GetPlayers() == 2 end, "two clients", 70)
local a, b = table.unpack(Players:GetPlayers())
for _, player in {a,b} do
	waitFor(function() return player.Character and player.Character:FindFirstChild("HumanoidRootPart") end, "character")
	player.Character.HumanoidRootPart:SetNetworkOwner(nil)
end
waitFor(function() return state:GetAttribute("Phase") == "live" end, "live shift")
local function go(player, point)
	local root = player.Character.HumanoidRootPart
	player.Character.Humanoid:MoveTo(Vector3.new(point.X, root.Position.Y, point.Z))
	waitFor(function() return (Vector3.new(root.Position.X,0,root.Position.Z)-Vector3.new(point.X,0,point.Z)).Magnitude < 2 end, "walk")
	task.wait(0.15)
end
local function prompt(name) return world:FindFirstChild(name):FindFirstChildWhichIsA("ProximityPrompt",true) end
local function walkPrompt(player, p)
	go(player, p.Parent.WorldPosition + Vector3.new(0,0,p.ObjectText == "Power cell" and 3 or -3))
	press:Invoke(p, player)
end
local function cell()
	for _, model in world:GetChildren() do
		local p = model.Name == "Power Cell" and model:FindFirstChildWhichIsA("ProximityPrompt",true)
		if p and p.Enabled and model.PrimaryPart.Position.Z == 42 and model.PrimaryPart.Position.X == -9 then return p end
	end
	error("first battery missing")
end
prepare:Invoke(a, "role", "Lure")
assert(a:GetAttribute("NextCrewRole") == "Carrier", "live role change accepted")
task.wait(0.6)
prepare:Invoke(a, "ability")
assert(a:GetAttribute("AbilityReadyAt") == 0, "empty carrier can dash")
walkPrompt(a, cell())
assert(a:GetAttribute("Carrying"))
prepare:Invoke(a,"ability")
local readyAt = a:GetAttribute("AbilityReadyAt")
assert(readyAt > workspace:GetServerTimeNow() and a.Character.Humanoid.WalkSpeed == 22, "dash failed")
prepare:Invoke(a,"ability")
assert(a:GetAttribute("AbilityReadyAt") == readyAt, "spam renewed dash")
walkPrompt(a, prompt("Delivery console"))
assert(a.Character.Humanoid.WalkSpeed == 16 and a:GetAttribute("SprintUntil") == 0, "delivery kept dash")
walkPrompt(a, prompt("01   BROADCAST"))
waitFor(function() return state:GetAttribute("Phase") == "won" and a:GetAttribute("Scrap") == 10 end, "dash delivery reward")
prepare:Invoke(a,"role","not-a-role")
task.wait(0.6)
prepare:Invoke(a,"role","Lure")
assert(a:GetAttribute("NextCrewRole") == "Lure" and a:GetAttribute("CrewRole") == "Carrier", "role activated too early")
waitFor(function() return state:GetAttribute("Phase") == "live" end, "next shift", 24)
assert(a:GetAttribute("CrewRole") == "Lure" and b:GetAttribute("CrewRole") == "Carrier")
go(a, Vector3.new(5,3,49))
walkPrompt(b,cell())
waitFor(function() return b:GetAttribute("Tracked") and state:GetAttribute("DecoyReady") end,"second player hunted")
prepare:Invoke(a,"ability", {fakePosition = Vector3.zero})
task.wait(0.6)
assert(not world:FindFirstChild("Portable crew beacon"),"malformed payload deployed beacon")
prepare:Invoke(a,"ability")
local deployed = assert(world:FindFirstChild("Portable crew beacon"),"lure not deployed")
local expires = state:GetAttribute("DecoyUntil")
assert(expires > workspace:GetServerTimeNow())
waitFor(function() return not b:GetAttribute("Tracked") end,"teammate rescued")
local beam = world.Sentinel.PrimaryPart.TrackingBeam
assert(beam.Attachment1 and beam.Attachment1.Parent == deployed,"drone not targeting portable beacon")
task.wait(0.6)
prepare:Invoke(a,"ability")
assert(state:GetAttribute("DecoyUntil") == expires,"spam extended distraction")
waitFor(function() return not world:FindFirstChild("Portable crew beacon") end,"expired beacon cleaned up",7)
assert(b:GetAttribute("AbilityReadyAt") == 0, "cooldown leaked to teammate")
print("ROLES QA PASS two clients, live selection rejection, dash reward, cargo reset, portable distraction, malformed payload, cooldown, cleanup")
test:EndTest("PASS")
