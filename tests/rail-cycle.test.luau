local R = require("../src/shared/RailCycle")
assert(R.at(0)=="clear" and R.at(9.99)=="clear" and R.at(10)=="warning" and R.at(13.99)=="warning")
local phase,x=R.at(14); assert(phase=="passing" and x==-110)
assert(R.at(22)=="clear")
assert(R.hit(0,3,-5,-30,30),"sweep must catch between frames")
assert(not R.hit(0,3,10,-30,30) and not R.hit(0,12,-5,-30,30))
assert(not R.hit(0,3,-5,nil,nil))
assert(R.choose({"yard","yard"},true)=="yard" and R.choose({"yard","depot"},true)=="depot")
assert(R.choose({"yard"},false)=="depot")
print("PASS: rail warning window, cycle wrap, swept hit bounds, majority and beginner gate")
local Journal = require("../src/server/EndingJournal")
local p = {UserId=90, SetAttribute=function(self,k,v) self[k]=v end}
local j=Journal.new(nil)
j:join(p)
j:award(p,"broadcast","yard")
assert(not p.ArchiveYard)
j:award(p,"shelter")
assert(j:award(p,"broadcast","yard") and p.ArchiveYard)
j:leave(p); j:join(p)
assert(p.ArchiveYard and not p.ArchiveGold)
assert(Journal.merge({yard=true},{yard=false}).yard)
print("PASS: yard recording unlock, rejoin and monotonic merge")
