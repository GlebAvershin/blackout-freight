local Round = require("../src/shared/Round")

local r = Round.new(2, 100, {1, 2, 3}, 25)
assert(r:pickup(12, 99, 10) == false)
assert(r:pickup(12, 1, 10))
assert(not r:pickup(99, 1, 10), "two players cannot claim the same cell")
assert(not r:pickup(12, 2, 10), "only one cell per player")
assert(not r:deposit(99, 20), "empty hand cannot score")
assert(r:drop(12) == 1)
assert(r:pickup(99, 1, 30), "dropped cargo can be recovered")
assert(r:deposit(99, 40))
assert(not r:deposit(99, 40), "delivery cannot be repeated")
assert(not r:pickup(12, 1, 40), "delivered cargo cannot be picked up")
assert(r:pickup(12, 2, 50))
assert(r:deposit(12, 60))
assert(r.outcome == "routing" and r.delivered == 2)
assert(not r:pickup(99, 3, 61), "pickups stop after the goal")

local expired = Round.new(1, 10, {1}, 25)
assert(expired:pickup(10, 1, 9))
assert(not expired:deposit(10, 10), "deadline wins even before the next frame")
assert(expired:expire(10) and expired.outcome == "lost")
assert(expired:drop(10) == 1)
print("PASS: contention, one cargo, recovery, scoring, victory, deadline")

local story = Round.new(1, 100, {1, 2}, 25)
assert(story:pickup(11, 1, 20))
assert(story:pickup(12, 2, 21))
assert(story:deposit(11, 99))
assert(story.outcome == "routing" and story.deadline == 124)
assert(not story:deposit(12, 100))
assert(not story:choose("invalid", 100))
assert(story:choose("broadcast", 123))
assert(not story:choose("shelter", 123), "only the first valid decision can win")
assert(story.outcome == "won" and story.ending == "broadcast")
assert(story.routeSource == "chosen", "a console choice is explicit")

local backup = Round.new(1, 50, {1}, 25)
assert(backup:pickup(1, 1, 5) and backup:deposit(1, 6))
assert(not backup:choose("broadcast", 31), "routing deadline cannot be extended by late input")
assert(backup:expire(31) and backup.ending == "shelter" and backup.outcome == "won")
assert(backup.routeSource == "automatic", "the shelter fallback is distinguishable from a choice")
assert(not backup:expire(32), "timeout must resolve once")
print("PASS: decision window, valid endings, first-choice wins, safe timeout")

local bonus = Round.new(1, 50, {1}, 25, "blackBox")
assert(bonus:pickup(8, "blackBox", 3))
assert(not bonus:pickup(9, "blackBox", 4))
assert(not bonus:assistBonus(8, 8) and bonus:assistBonus(8, 9))
assert(bonus:drop(8) == "blackBox")
assert(bonus:pickup(10, "blackBox", 5))
local accepted, optional, helper = bonus:deposit(10, 6)
assert(accepted and optional and helper == nil and bonus.delivered == 0 and bonus.outcome == "live")
assert(not bonus:pickup(8, "blackBox", 7))
assert(bonus:pickup(8, 1, 8) and bonus:deposit(8, 9) and bonus.outcome == "routing")
local crew = Round.new(1, 50, {1}, 25, "blackBox")
assert(crew:pickup(8, "blackBox", 3) and crew:assistBonus(8, 9))
local crewAccepted, crewOptional, crewHelper, seconds = crew:deposit(8, 10)
assert(crewAccepted and crewOptional and crewHelper == 9 and seconds == 7)
print("PASS: optional cargo, contested pickup, dropped assist, delivery and crew credit")
