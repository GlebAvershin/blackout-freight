local Track=require("../src/shared/RankTrack")
local current,nextReward,fraction=Track.progress(nil)
assert(current==nil and nextReward.rank==2 and fraction==0)
current,nextReward,fraction=Track.progress(249)
assert(current==nil and fraction<1)
current,nextReward,fraction=Track.progress(250)
assert(current.id=="Runner" and nextReward.rank==3 and fraction==0)
current,nextReward,fraction=Track.progress(375)
assert(fraction==0.5)
current,nextReward,fraction=Track.progress(500)
assert(current.id=="Keeper" and nextReward.rank==5 and fraction==0)
current,nextReward,fraction=Track.progress(1000)
assert(current.id=="Dispatcher" and nextReward==nil and fraction==1)
assert(Track.unlocked(249,250).rank==2 and Track.unlocked(499,500).rank==3)
assert(Track.unlocked(999,1000).rank==5 and Track.unlocked(250,250)==nil and Track.unlocked(250,100)==nil)
assert(Track.progress(0/0)==nil and Track.progress(-1)==nil)
print("PASS: career thresholds, progress fractions, duplicate and downward unlock rejection")
